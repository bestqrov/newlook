# ─── Required ────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/newlook
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Server ──────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of front-end origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway...)
TRUST_PROXY=0
# lax (same site) or none (front and API on different domains, requires HTTPS)
COOKIE_SAMESITE=lax

# ─── Business rules ──────────────────────────────────────────────────
# Free trial given to a new business (days). 0 = no trial.
TRIAL_DAYS=30

# ─── Files ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
# Optional: serve the built front-end (../dist) from this server
SERVE_CLIENT_DIR=
